{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "casa-cavour.com"
        }
      ],
      "destination": "https://www.casa-cavour.com/$1",
      "permanent": true
    },
    {
      "source": "/post/giro-italia-cervia-2026.html",
      "destination": "/post/giro-italia-bertinoro-2027.html",
      "permanent": true
    },
    {
      "source": "/post/pasqua-romagna-2026.html",
      "destination": "/post/geo-aeo-cosa-fare-bertinoro-weekend-2026.html",
      "permanent": true
    },
    {
      "source": "/post/aprile-in-romagna.html",
      "destination": "/post/geo-aeo-cosa-fare-bertinoro-weekend-2026.html",
      "permanent": true
    },
    {
      "source": "/post/artigiamo-santarcangelo-aprile-2026.html",
      "destination": "/post/geo-aeo-cosa-fare-bertinoro-weekend-2026.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
